{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build aI'm Thinking Debug.app",
      "type": "shell",
      "command": "CONFIG=debug ./scripts/build-app.sh",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build & Run aI'm Thinking Debug.app",
      "type": "shell",
      "command": "CONFIG=debug ./scripts/build-app.sh && open \".build/debug/aI'm Thinking Debug.app\"",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Rust Core",
      "type": "shell",
      "command": "cargo build --manifest-path core/Cargo.toml",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
